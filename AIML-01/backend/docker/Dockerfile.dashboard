FROM python:3.11-slim
WORKDIR /app
RUN pip install --no-cache-dir streamlit==1.35.0 pandas==2.1.4 sqlalchemy==2.0.30 psycopg2-binary==2.9.9 matplotlib==3.8.4 networkx==3.3
COPY fraud/dashboard ./fraud/dashboard
COPY fraud/__init__.py ./fraud/__init__.py
ENV PYTHONPATH=/app
EXPOSE 8501
CMD ["streamlit", "run", "fraud/dashboard/app.py", "--server.port=8501", "--server.address=0.0.0.0"]
