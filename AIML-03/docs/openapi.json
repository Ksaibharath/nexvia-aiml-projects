      "get": {
        "summary": "Recommend",
        "operationId": "recommend_api_recommend_get",
        "parameters": [
          {
            "name": "user_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "description": "MovieLens user ID (use e.g. 99999999 for a brand-new cold-start user)",
              "title": "User Id"
            },
            "description": "MovieLens user ID (use e.g. 99999999 for a brand-new cold-start user)"
          },
          {
            "name": "k",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 50,
              "minimum": 1,
              "description": "Number of movies to return",
              "default": 10,
              "title": "K"
            },
            "description": "Number of movies to return"
          },
          {
            "name": "liked",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Comma-separated item_idx values for new-user content-based onboarding",
              "default": "",
              "title": "Liked"
            },
            "description": "Comma-separated item_idx values for new-user content-based onboarding"
          },
          {
            "name": "genres",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Comma-separated genre names for cold-start genre filtering",
              "default": "",
              "title": "Genres"
            },
            "description": "Comma-separated genre names for cold-start genre filtering"
          },
          {
            "name": "variant",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Optional A/B override ('A' = Wide & Deep, 'B' = DCN-V2)",
              "default": "",
              "title": "Variant"
            },
            "description": "Optional A/B override ('A' = Wide & Deep, 'B' = DCN-V2)"
          },
          {
            "name": "bypass_cache",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "Skip Redis/memory cache to measure fresh model inference",
              "default": false,
              "title": "Bypass Cache"
            },
            "description": "Skip Redis/memory cache to measure fresh model inference"
          }
        ],
