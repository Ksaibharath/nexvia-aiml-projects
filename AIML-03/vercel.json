{
  "version": 2,
  "outputDirectory": "public",
  "functions": {
    "api/index.mjs": {
      "includeFiles": "{deploy_bundle/**,lib/**}"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.mjs?__path=api/:path*" },
    { "source": "/recommend", "destination": "/api/index.mjs?__path=recommend" },
    { "source": "/health", "destination": "/api/index.mjs?__path=health" }
  ]
}
